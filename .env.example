# Environment Configuration
# Copy this file to .env.local and fill in your values

# Application
NODE_ENV=development

# Public Configuration (accessible in browser - NEVER put secrets here)
# Prefix with VITE_ to make available to client
VITE_APP_NAME=Companion UI Builder
VITE_APP_URL=http://localhost:5173

# Server-only Configuration (not accessible in browser)
# These are only available in .server.ts files and server functions
# DATABASE_URL=
# API_SECRET=
